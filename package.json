    "qa": "tsx src/cli.ts qa",
    "still": "tsx src/cli.ts still"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.88",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "ffprobe-static": "3.1.0",
    "zod": "4.6.7",
    "@ffmpeg-installer/ffmpeg": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
